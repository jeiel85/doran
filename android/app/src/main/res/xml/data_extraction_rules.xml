<?xml version="1.0" encoding="utf-8"?>
<!-- 장부·키는 Google 백업·기기 이전으로 옮기지 않습니다. 복구는 암호 백업 파일로만 (DECISIONS.md D-11). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
